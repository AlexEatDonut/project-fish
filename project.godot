; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project Fish"
config/description="A small game about chilling and fishing."
config/version="0.0.0.3"
run/main_scene="res://maaack-menus/scenes/opening/opening.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
run/max_fps=120
config/icon="uid://buj2j3wqv1pu3"

[autoload]

Playerinfo="*res://scripts/playerinfo.tscn"
Gamedata="*res://scripts/gamedata.tscn"
FishFinder="*res://scripts/fish_finder.tscn"
SoundManager="*res://addons/sound_manager/sound_manager.gd"
AppConfig="*res://addons/maaacks_menus_template/base/nodes/autoloads/app_config/app_config.tscn"
SceneLoader="*res://addons/maaacks_menus_template/base/nodes/autoloads/scene_loader/scene_loader.tscn"
ProjectMusicController="*res://addons/maaacks_menus_template/base/nodes/autoloads/music_controller/project_music_controller.tscn"
ProjectUISoundController="*res://addons/maaacks_menus_template/base/nodes/autoloads/ui_sound_controller/project_ui_sound_controller.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/FreeControl/plugin.cfg", "res://addons/godotvmf/plugin.cfg", "res://addons/project-time-tracker/plugin.cfg", "res://addons/scene_container/plugin.cfg", "res://addons/sound_manager/plugin.cfg", "res://addons/ui_outlines/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://entities/": "red",
"res://godotvmfcontent/": "gray",
"res://maaack-menus/": "gray",
"res://maps/": "orange",
"res://materials/": "yellow",
"res://non-godot-files/": "gray",
"res://scripts/": "green",
"res://shaders/": "teal",
"res://sounds/": "blue"
}

[godot_vmf]

import/instances_folder="res://godotvmfcontent/instances"
import/entities_folder="res://godotvmfcontent/entities"
import/geometry_folder="res://godotvmfcontent/geometry"
models/import=true
models/target_folder="res://godotvmfcontent/models"
materials/import_mode=1
materials/target_folder="res://godotvmfcontent/materials"

