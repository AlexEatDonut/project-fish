; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="project-fish"
config/features=PackedStringArray("4.5", "Forward Plus")
run/max_fps=120
config/icon="res://icon.svg"

[autoload]

Playerinfo="*res://scripts/playerinfo.tscn"
SoundManager="*res://addons/sound_manager/sound_manager.gd"
FishFinder="*res://scripts/fish_finder.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/FreeControl/plugin.cfg", "res://addons/godotvmf/plugin.cfg", "res://addons/project-time-tracker/plugin.cfg", "res://addons/scene_container/plugin.cfg", "res://addons/sound_manager/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://entities/": "red",
"res://godotvmfcontent/": "gray",
"res://maps/": "orange",
"res://materials/": "yellow",
"res://non-godot-files/": "gray",
"res://scripts/": "green",
"res://shaders/": "teal",
"res://sounds/": "blue"
}

[godot_vmf]

import/instances_folder="res://godotvmfcontent/instances"
import/entities_folder="res://godotvmfcontent/entities"
import/geometry_folder="res://godotvmfcontent/geometry"
models/import=true
models/target_folder="res://godotvmfcontent/models"
materials/import_mode=1
materials/target_folder="res://godotvmfcontent/materials"

[input]

Lclick={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed":false,"double_click":false,"script":null)
]
}
